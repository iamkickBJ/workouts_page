            <ns3:atemp>31.0</ns3:atemp>
            <ns3:hr>144</ns3:hr>
            <ns3:cad>85</ns3:cad>
          </ns3:TrackPointExtension>
        </extensions>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
